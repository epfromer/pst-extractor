{
  "name": "pst-extractor",
  "version": "2.0.0",
  "description": "Extract objects from MS Outlook/Exchange PST files",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "lint": "eslint src benchmark --max-warnings=0",
    "test": "cross-env CI=1 jest --coverage --reporters=default --reporters=jest-junit",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "benchmark": "pnpm run build && node benchmark/async-vs-sync.mjs",
    "security:audit": "pnpm audit --audit-level high"
  },
  "repository": "epfromer/pst-extractor",
  "author": "Ed Pfromer (epfromer@gmail.com)",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "long": "^5.3.2",
    "uuid-parse": "^1.1.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "endOfLine": "auto"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-typescript"
    ]
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts",
      "!<rootDir>/src/__tests__/**/*.*"
    ],
    "coverageReporters": [
      "text",
      "cobertura"
    ]
  }
}
