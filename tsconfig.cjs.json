{
  "compilerOptions": {
    "strict": true,
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Disposable"],
    "rootDir": "./.build/cjs-src",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist/cjs",
    "declaration": false,
    "sourceMap": true
  },
  "include": [".build/cjs-src/**/*.ts"]
}
