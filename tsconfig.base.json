{
  "compilerOptions": {
    "strict": true,
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Disposable"],
    "rootDir": "./src",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/__tests__/**"]
}
