{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "ESNext.Disposable"],
    "module": "commonjs",
    "noImplicitAny": true,
    "outDir": "./dist",
    "strict": true,
    "target": "ES2022"
  },
  "exclude": ["node_modules", "src/__tests__/*"],
  "include": ["src/**/*"]
}
